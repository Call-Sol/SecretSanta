# Copy to .env and fill in the bot credentials from BotFather.
DATABASE_URL=postgres://secretsanta:secretsanta@localhost:54329/secretsanta?sslmode=disable
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=
HTTP_ADDR=:8080
LOG_LEVEL=info
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=20
SESSION_TTL=30m
